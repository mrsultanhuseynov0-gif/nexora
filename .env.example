# Copy to server/.env for local API, or set in Render / Vercel dashboards.

# --- Server (Render) ---
NODE_ENV=production
PORT=8787
HOST=0.0.0.0
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=8h

# Public URLs (no trailing slash)
# Monolith on Render: both can be the same Render URL
PUBLIC_SITE_URL=https://your-app.onrender.com
PUBLIC_API_URL=

# Comma-separated browser origins allowed for CORS when frontend is split
# Example: https://nexora.vercel.app,https://nexora.pages.dev
# Use * (default) to reflect request Origin
CORS_ORIGINS=*

# SQLite path (Render free: ephemeral disk — data resets on redeploy)
# DATABASE_PATH=/var/data/nexora.db
# DATABASE_DIR=/var/data

# Future: Supabase / Postgres (schema in supabase/schema.sql — not wired to runtime yet)
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_ANON_KEY=

# Optional image CDN (catalog already uses Unsplash/Wikimedia)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Trust X-Forwarded-* from Render / Cloudflare
TRUST_PROXY=1
